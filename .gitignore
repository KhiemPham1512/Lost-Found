# =====================================================================
#  .gitignore TỔNG cho dự án Lost & Found
#  Đặt ở thư mục gốc của repo. Áp dụng cho cả backend, mobile, admin-web.
#  Quy tắc: thứ gì là BÍ MẬT hoặc do máy tự sinh ra thì KHÔNG đưa lên Git.
# =====================================================================

# ---------------------------------------------------------------------
# 1. BÍ MẬT (quan trọng nhất - tuyệt đối không commit)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# File cấu hình khóa của Android (chứa SUPABASE_URL, key...)
local.properties
# Khóa ký ứng dụng Android
*.keystore
*.jks
# File cấu hình cá nhân khi phát triển (chứa mật khẩu tài khoản thử, token): KHÔNG commit
*.local.json

# ---------------------------------------------------------------------
# 2. PYTHON / FASTAPI (backend/)
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.test-postgres/
admin-web/test-results/
admin-web/playwright-report/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ---------------------------------------------------------------------
# 3. ANDROID / KOTLIN (mobile/)
# ---------------------------------------------------------------------
*.iml
.gradle/
build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
# Thư mục tạm của Kotlin
.kotlin/

# ---------------------------------------------------------------------
# 4. NODE / REACT (admin-web/)
# ---------------------------------------------------------------------
node_modules/
dist/
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ---------------------------------------------------------------------
# 5. SUPABASE CLI (supabase/)
# ---------------------------------------------------------------------
supabase/.temp/
supabase/.branches/

# ---------------------------------------------------------------------
# 6. EDITOR / HỆ ĐIỀU HÀNH / LOG
# ---------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp

# Local working notes and visual QA artifacts; never publish with source.
.local-artifacts/
.codegraph/

# Shared AI instructions are versioned; skills and local verification stay local.
/.agents/
/GLOSSARY.md
/backend/tests/
/backend/requirements-dev.txt
/backend/pytest.ini
/backend/mypy.ini
/backend/ruff.toml
/admin-web/tests/
/admin-web/playwright.config.ts
