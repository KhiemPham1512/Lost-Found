# Sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# File ".env" KHÔNG được commit. File ".env.example" này thì được commit vì chỉ là bản mẫu.
# Sửa .env xong phải bấm Ctrl+S và KHỞI ĐỘNG LẠI server (uvicorn không tự đọc lại .env).

# Địa chỉ project. Đúng dạng dưới đây: không thừa chữ cái ở đầu, KHÔNG có /rest/v1/ ở cuối.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Khóa secret: CHỈ backend được giữ. Không gửi cho ai, không chụp màn hình.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Chuỗi kết nối database: Supabase > nút Connect > Session pooler.
# Thay [YOUR-PASSWORD] bằng mật khẩu database. Mật khẩu có ký tự đặc biệt (@ : / ? #) phải mã hóa URL.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-ID:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Địa chỉ web được phép gọi API (admin web khi chạy ở máy)
ALLOWED_ORIGINS=http://localhost:5173
